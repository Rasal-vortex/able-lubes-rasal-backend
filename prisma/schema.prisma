// Phase 1 proposal. Confirm open business rules in PROJECT_PHASE_1.md before
// treating this as the production schema or creating the first migration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum SaleStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  COUPON
}

enum PurchaseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockMovementType {
  OPENING_STOCK
  ADJUSTMENT
}

enum StockDirection {
  IN
  OUT
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           UserRole        @default(STAFF)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  stockMovements StockMovement[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  brandId      String   @map("brand_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchaseRate Decimal  @default(0) @map("purchase_rate") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([brandId])
  @@index([unitId])
  @@map("products")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("brands")
}

model Unit {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  symbol         String?   @db.VarChar(5)
  active         Boolean   @default(true)
  allowsDecimals Boolean   @default(false) @map("allows_decimals")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  products       Product[]

  @@map("units")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  direction   StockDirection
  quantity    Decimal           @db.Decimal(12, 3)
  stockAfter  Decimal           @map("stock_after") @db.Decimal(12, 3)
  reason      String
  notes       String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([createdById])
  @@map("stock_movements")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales    Sale[]
  payments CustomerPayment[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number")
  customerId     String?       @map("customer_id") @db.Uuid
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billDate       DateTime      @map("bill_date") @db.Timestamptz(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  status         SaleStatus    @default(DRAFT)
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  items    SaleItem[]
  payments CustomerPayment[]
  coupon   Coupon?

  @@index([customerId, billDate])
  @@index([status, billDate])
  @@map("sales")
}

model Coupon {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  price       Decimal  @db.Decimal(12, 2)
  isSaleBased Boolean  @default(false) @map("is_sale_based")
  saleId      String?  @unique @map("sale_id") @db.Uuid
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isSaleBased])
  @@map("coupons")
}

model SaleItem {
  id                     String   @id @default(uuid()) @db.Uuid
  saleId                 String   @map("sale_id") @db.Uuid
  sale                   Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId              String   @map("product_id") @db.Uuid
  product                Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity               Decimal  @db.Decimal(12, 3)
  displayQuantity        Decimal? @map("display_quantity") @db.Decimal(12, 3)
  displayUnitNameSnapshot String?  @map("display_unit_name_snapshot")
  displayUnitSymbolSnapshot String? @map("display_unit_symbol_snapshot")
  unitSellingPrice       Decimal  @map("unit_selling_price") @db.Decimal(12, 2)
  discountAmount         Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal              Decimal  @map("line_total") @db.Decimal(12, 2)
  historicalCostSnapshot Decimal? @map("historical_cost_snapshot") @db.Decimal(12, 2)
  unitNameSnapshot      String   @map("unit_name_snapshot")
  unitSymbolSnapshot    String?  @map("unit_symbol_snapshot")
  unitAllowsDecimalsSnapshot Boolean @map("unit_allows_decimals_snapshot")

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model CustomerPayment {
  id          String        @id @default(uuid()) @db.Uuid
  customerId  String?       @map("customer_id") @db.Uuid
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleId      String?       @map("sale_id") @db.Uuid
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @map("payment_date") @db.Timestamptz(3)
  method      PaymentMethod
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([customerId, paymentDate])
  @@index([saleId])
  @@map("customer_payments")
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  purchaseNumber        String         @unique @map("purchase_number")
  supplierId            String         @map("supplier_id") @db.Uuid
  supplier              Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierInvoiceNumber String?        @map("supplier_invoice_number")
  purchaseDate          DateTime       @map("purchase_date") @db.Timestamptz(3)
  subtotal              Decimal        @db.Decimal(12, 2)
  discountAmount        Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount           Decimal        @map("total_amount") @db.Decimal(12, 2)
  status                PurchaseStatus @default(DRAFT)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  items    PurchaseItem[]
  payments SupplierPayment[]

  @@index([supplierId, purchaseDate])
  @@index([status, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id           String   @id @default(uuid()) @db.Uuid
  purchaseId   String   @map("purchase_id") @db.Uuid
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Decimal  @db.Decimal(12, 3)
  supplierRate Decimal  @map("supplier_rate") @db.Decimal(12, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  unitNameSnapshot String @map("unit_name_snapshot")
  unitSymbolSnapshot String? @map("unit_symbol_snapshot")
  unitAllowsDecimalsSnapshot Boolean @map("unit_allows_decimals_snapshot")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model SupplierPayment {
  id          String        @id @default(uuid()) @db.Uuid
  supplierId  String        @map("supplier_id") @db.Uuid
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseId  String?       @map("purchase_id") @db.Uuid
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  paymentGroupId String?     @map("payment_group_id") @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @map("payment_date") @db.Timestamptz(3)
  method      PaymentMethod
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([supplierId, paymentDate])
  @@index([purchaseId])
  @@index([paymentGroupId])
  @@map("supplier_payments")
}

model Expense {
  id            String         @id @default(uuid()) @db.Uuid
  description   String
  category      String
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime       @map("expense_date") @db.Timestamptz(3)
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([expenseDate, category])
  @@map("expenses")
}
