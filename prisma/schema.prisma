// Phase 1 proposal. Confirm open business rules in PROJECT_PHASE_1.md before
// treating this as the production schema or creating the first migration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum SaleStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum SalesReturnStatus {
  NONE
  PARTIALLY_RETURNED
  FULLY_RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  COUPON
  STORE_CREDIT
}

enum SalesReturnSettlementType {
  BALANCE_OFFSET
  REFUND
  CUSTOMER_CREDIT
  PENDING
}

enum CustomerStoreCreditType {
  CREDIT
  DEBIT
}

enum RefundMethod {
  CASH
  UPI
  BANK
  OTHER
}

enum SalePaymentCorrectionType {
  REVERSAL
  ACTUAL_RECEIPT
}

enum PurchaseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockMovementType {
  OPENING_STOCK
  ADJUSTMENT
  SALE_RETURN
  PURCHASE_CANCEL
}

enum StockDirection {
  IN
  OUT
}

enum InventoryBatchSource {
  PURCHASE
  OPENING
  ADJUSTMENT
}

enum InventoryBatchStatus {
  ACTIVE
  DEPLETED
  CANCELLED
}

enum SaleCostSource {
  VERIFIED_BATCH
  LEGACY_ESTIMATE
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String           @map("password_hash")
  role            UserRole         @default(STAFF)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  stockMovements  StockMovement[]
  saleCancellations SaleCancellation[]
  saleRefunds     SaleRefund[]
  paymentCorrections SalePaymentCorrection[] @relation("SalePaymentCorrectionCreatedBy")
  salesReturns SalesReturn[]
  salesReturnSettlements SalesReturnSettlement[]
  purchaseCancellations PurchaseCancellation[]
  supplierRefundSettlements SupplierRefundSettlement[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  brandId      String   @map("brand_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchaseRate Decimal  @default(0) @map("purchase_rate") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  inventoryBatches InventoryBatch[]
  updateOperations ProductUpdateOperation[]

  @@index([name])
  @@index([brandId])
  @@index([unitId])
  @@map("products")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("brands")
}

model Unit {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  symbol         String?   @db.VarChar(5)
  active         Boolean   @default(true)
  allowsDecimals Boolean   @default(false) @map("allows_decimals")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  products       Product[]

  @@map("units")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryBatchId String?      @map("inventory_batch_id") @db.Uuid
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  type        StockMovementType
  direction   StockDirection
  quantity    Decimal           @db.Decimal(12, 3)
  stockAfter  Decimal           @map("stock_after") @db.Decimal(12, 3)
  reason      String
  notes       String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([inventoryBatchId])
  @@index([createdById])
  @@map("stock_movements")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales       Sale[]
  payments    CustomerPayment[]
  creditBills CustomerCreditBill[]
  storeCreditTransactions CustomerStoreCreditTransaction[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  payments  SupplierPayment[]
  supplierCredits SupplierCredit[]

  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  idempotencyKey String?       @unique @map("idempotency_key") @db.Uuid
  requestHash    String?       @map("request_hash") @db.VarChar(64)
  invoiceNumber  String        @unique @map("invoice_number")
  customerId     String?       @map("customer_id") @db.Uuid
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billDate       DateTime      @map("bill_date") @db.Timestamptz(3)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  status         SaleStatus    @default(DRAFT)
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  settledAt      DateTime?     @map("settled_at") @db.Timestamptz(3)
  returnStatus   SalesReturnStatus @default(NONE) @map("return_status")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  items      SaleItem[]
  payments   CustomerPayment[]
  coupon     Coupon?
  creditBill CustomerCreditBill?
  cancellation SaleCancellation?
  returns      SalesReturn[]
  storeCreditTransactions CustomerStoreCreditTransaction[]

  @@index([customerId, billDate])
  @@index([status, billDate])
  @@index([settledAt])
  @@map("sales")
}

model SaleInvoiceCounter {
  dateKey      String @id @map("date_key") @db.VarChar(6)
  lastSequence Int    @default(0) @map("last_sequence")

  @@map("sale_invoice_counters")
}

model Coupon {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  price       Decimal  @db.Decimal(12, 2)
  isSaleBased Boolean  @default(false) @map("is_sale_based")
  saleId      String?  @unique @map("sale_id") @db.Uuid
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isSaleBased])
  @@map("coupons")
}

model SaleItem {
  id                         String   @id @default(uuid()) @db.Uuid
  saleId                     String   @map("sale_id") @db.Uuid
  sale                       Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId                  String   @map("product_id") @db.Uuid
  product                    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryBatchId           String?  @map("inventory_batch_id") @db.Uuid
  inventoryBatch             InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  quantity                   Decimal  @db.Decimal(12, 3)
  displayQuantity            Decimal? @map("display_quantity") @db.Decimal(12, 3)
  displayUnitNameSnapshot    String?  @map("display_unit_name_snapshot")
  displayUnitSymbolSnapshot  String?  @map("display_unit_symbol_snapshot")
  unitSellingPrice           Decimal  @map("unit_selling_price") @db.Decimal(12, 2)
  discountAmount             Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal                  Decimal  @map("line_total") @db.Decimal(12, 2)
  historicalCostSnapshot     Decimal? @map("historical_cost_snapshot") @db.Decimal(12, 2)
  historicalMrpSnapshot      Decimal? @map("historical_mrp_snapshot") @db.Decimal(12, 2)
  batchSellingPriceSnapshot  Decimal? @map("batch_selling_price_snapshot") @db.Decimal(12, 2)
  costSnapshotSource         SaleCostSource? @map("cost_snapshot_source")
  unitNameSnapshot           String   @map("unit_name_snapshot")
  unitSymbolSnapshot         String?  @map("unit_symbol_snapshot")
  unitAllowsDecimalsSnapshot Boolean  @map("unit_allows_decimals_snapshot")
  returns                    SalesReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([inventoryBatchId])
  @@map("sale_items")
}

model CustomerPayment {
  id          String        @id @default(uuid()) @db.Uuid
  idempotencyKey String?    @unique @map("idempotency_key") @db.Uuid
  customerId  String?       @map("customer_id") @db.Uuid
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleId      String?       @map("sale_id") @db.Uuid
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  refunds     SaleRefund[]
  corrections SalePaymentCorrection[] @relation("OriginalPaymentCorrection")
  storeCreditTransaction CustomerStoreCreditTransaction?
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @map("payment_date") @db.Timestamptz(3)
  method      PaymentMethod
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([customerId, paymentDate])
  @@index([saleId])
  @@map("customer_payments")
}

model SaleCancellation {
  id              String      @id @default(uuid()) @db.Uuid
  saleId          String      @unique @map("sale_id") @db.Uuid
  sale            Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reason          String
  cancelledAt     DateTime    @default(now()) @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?     @map("cancelled_by_id") @db.Uuid
  cancelledBy     User?       @relation(fields: [cancelledById], references: [id], onDelete: Restrict)
  collectedAmount Decimal     @map("collected_amount") @db.Decimal(12, 2)
  actualReceivedAmount Decimal @default(0) @map("actual_received_amount") @db.Decimal(12, 2)
  pendingAmount   Decimal     @default(0) @map("pending_amount") @db.Decimal(12, 2)
  creditReversedAmount Decimal? @map("credit_reversed_amount") @db.Decimal(12, 2)
  refunds         SaleRefund[]
  paymentCorrections SalePaymentCorrection[]
  storeCreditRestorations CustomerStoreCreditTransaction[]

  @@index([cancelledAt])
  @@index([cancelledById])
  @@map("sale_cancellations")
}

model SalePaymentCorrection {
  id               String                    @id @default(uuid()) @db.Uuid
  cancellationId   String                    @map("cancellation_id") @db.Uuid
  cancellation     SaleCancellation          @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  originalPaymentId String?                  @map("original_payment_id") @db.Uuid
  originalPayment  CustomerPayment?          @relation("OriginalPaymentCorrection", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  type             SalePaymentCorrectionType
  amount           Decimal                   @db.Decimal(12, 2)
  method           RefundMethod
  reason           String
  createdById      String?                   @map("created_by_id") @db.Uuid
  createdBy        User?                     @relation("SalePaymentCorrectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cancellationId, createdAt])
  @@index([originalPaymentId])
  @@index([createdById])
  @@map("sale_payment_corrections")
}

model SaleRefund {
  id             String           @id @default(uuid()) @db.Uuid
  idempotencyKey String?          @unique @map("idempotency_key") @db.Uuid
  cancellationId String           @map("cancellation_id") @db.Uuid
  cancellation   SaleCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  originalPaymentId String?       @map("original_payment_id") @db.Uuid
  originalPayment   CustomerPayment? @relation(fields: [originalPaymentId], references: [id], onDelete: Restrict)
  amount         Decimal          @db.Decimal(12, 2)
  method         RefundMethod
  reference      String?
  createdById    String?          @map("created_by_id") @db.Uuid
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cancellationId, createdAt])
  @@index([createdById])
  @@map("sale_refunds")
}

model SalesReturn {
  id             String                      @id @default(uuid()) @db.Uuid
  idempotencyKey String                      @unique @map("idempotency_key") @db.Uuid
  saleId         String                      @map("sale_id") @db.Uuid
  sale           Sale                        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reason         String
  settlementType SalesReturnSettlementType   @map("settlement_type")
  returnedAt     DateTime                    @default(now()) @map("returned_at") @db.Timestamptz(3)
  returnedById   String?                     @map("returned_by_id") @db.Uuid
  returnedBy     User?                       @relation(fields: [returnedById], references: [id], onDelete: Restrict)
  amount         Decimal                     @db.Decimal(12, 2)
  creditAppliedAmount Decimal @default(0) @map("credit_applied_amount") @db.Decimal(12, 2)
  items          SalesReturnItem[]
  settlements    SalesReturnSettlement[]
  storeCreditTransaction CustomerStoreCreditTransaction?

  @@index([saleId, returnedAt])
  @@index([returnedById])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(uuid()) @db.Uuid
  salesReturnId String      @map("sales_return_id") @db.Uuid
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  saleItemId    String      @map("sale_item_id") @db.Uuid
  saleItem      SaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  quantity      Decimal     @db.Decimal(12, 3)
  amount        Decimal     @db.Decimal(12, 2)
  costAmount    Decimal     @map("cost_amount") @db.Decimal(12, 2)

  @@index([salesReturnId])
  @@index([saleItemId])
  @@map("sales_return_items")
}

model SalesReturnSettlement {
  id             String                    @id @default(uuid()) @db.Uuid
  idempotencyKey String?                   @unique @map("idempotency_key") @db.Uuid
  salesReturnId  String                    @map("sales_return_id") @db.Uuid
  salesReturn    SalesReturn               @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  type           SalesReturnSettlementType
  amount         Decimal                   @db.Decimal(12, 2)
  method         RefundMethod?
  reference      String?
  createdById    String?                   @map("created_by_id") @db.Uuid
  createdBy      User?                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([salesReturnId, createdAt])
  @@index([createdById])
  @@map("sales_return_settlements")
}

model CustomerStoreCreditTransaction {
  id            String                  @id @default(uuid()) @db.Uuid
  customerId    String                  @map("customer_id") @db.Uuid
  customer      Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type          CustomerStoreCreditType
  amount        Decimal                 @db.Decimal(12, 2)
  salesReturnId String?                 @unique @map("sales_return_id") @db.Uuid
  salesReturn   SalesReturn?            @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  saleId        String?                 @map("sale_id") @db.Uuid
  sale          Sale?                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  paymentId     String?                 @unique @map("payment_id") @db.Uuid
  payment       CustomerPayment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cancellationId String?                @map("cancellation_id") @db.Uuid
  cancellation  SaleCancellation?       @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  reversalOfTransactionId String?        @unique @map("reversal_of_transaction_id") @db.Uuid
  reversalOfTransaction CustomerStoreCreditTransaction? @relation("CustomerStoreCreditReversals", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversedBy CustomerStoreCreditTransaction? @relation("CustomerStoreCreditReversals")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([saleId])
  @@index([cancellationId])
  @@map("customer_store_credit_transactions")
}

model CustomerCreditBill {
  id           String                      @id @default(uuid()) @db.Uuid
  customerId   String                      @map("customer_id") @db.Uuid
  customer     Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  saleId       String?                     @unique @map("sale_id") @db.Uuid
  sale         Sale?                       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  billNumber   String                      @unique @map("bill_number")
  billDate     DateTime                    @map("bill_date") @db.Timestamptz(3)
  dueDate      DateTime                    @map("due_date") @db.Timestamptz(3)
  term         String
  billAmount   Decimal                     @map("bill_amount") @db.Decimal(12, 2)
  priorBalance Decimal                     @default(0) @map("prior_balance") @db.Decimal(12, 2)
  remarks      String?
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  payments     CustomerCreditBillPayment[]

  @@index([customerId, billDate])
  @@map("customer_credit_bills")
}

model CustomerCreditBillPayment {
  id           String             @id @default(uuid()) @db.Uuid
  creditBillId String             @map("credit_bill_id") @db.Uuid
  creditBill   CustomerCreditBill @relation(fields: [creditBillId], references: [id], onDelete: Restrict)
  amount       Decimal            @db.Decimal(12, 2)
  paymentDate  DateTime           @map("payment_date") @db.Timestamptz(3)
  method       PaymentMethod
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([creditBillId, paymentDate])
  @@map("customer_credit_bill_payments")
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  idempotencyKey        String?        @unique @map("idempotency_key") @db.Uuid
  purchaseNumber        String         @unique @map("purchase_number")
  supplierId            String         @map("supplier_id") @db.Uuid
  supplier              Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierInvoiceNumber String?        @map("supplier_invoice_number")
  purchaseDate          DateTime       @map("purchase_date") @db.Timestamptz(3)
  subtotal              Decimal        @db.Decimal(12, 2)
  discountAmount        Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount           Decimal        @map("total_amount") @db.Decimal(12, 2)
  status                PurchaseStatus @default(DRAFT)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  items    PurchaseItem[]
  payments SupplierPayment[]
  cancellation PurchaseCancellation?
  supplierCreditApplications SupplierCreditApplication[]

  @@index([supplierId, purchaseDate])
  @@index([status, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id                         String   @id @default(uuid()) @db.Uuid
  purchaseId                 String   @map("purchase_id") @db.Uuid
  purchase                   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  productId                  String   @map("product_id") @db.Uuid
  product                    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryBatch             InventoryBatch?
  quantity                   Decimal  @db.Decimal(12, 3)
  supplierRate               Decimal  @map("supplier_rate") @db.Decimal(12, 2)
  lineTotal                  Decimal  @map("line_total") @db.Decimal(12, 2)
  unitNameSnapshot           String   @map("unit_name_snapshot")
  unitSymbolSnapshot         String?  @map("unit_symbol_snapshot")
  unitAllowsDecimalsSnapshot Boolean  @map("unit_allows_decimals_snapshot")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryBatch {
  id                String               @id @default(uuid()) @db.Uuid
  productId         String               @map("product_id") @db.Uuid
  product           Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseItemId    String?              @unique @map("purchase_item_id") @db.Uuid
  purchaseItem      PurchaseItem?        @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  label             String?
  receivedQuantity  Decimal              @map("received_quantity") @db.Decimal(12, 3)
  remainingQuantity Decimal              @map("remaining_quantity") @db.Decimal(12, 3)
  purchaseRate      Decimal              @map("purchase_rate") @db.Decimal(12, 2)
  sellingRate       Decimal              @map("selling_rate") @db.Decimal(12, 2)
  mrp               Decimal?             @db.Decimal(12, 2)
  isDefaultSellingRate Boolean            @default(false) @map("is_default_selling_rate")
  receivedAt        DateTime             @map("received_at") @db.Timestamptz(3)
  source            InventoryBatchSource
  status            InventoryBatchStatus @default(ACTIVE)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  @@index([productId, status, receivedAt])
  @@map("inventory_batches")
}

model ProductUpdateOperation {
  idempotencyKey String   @id @map("idempotency_key") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, createdAt])
  @@map("product_update_operations")
}

model SupplierPayment {
  id             String        @id @default(uuid()) @db.Uuid
  supplierId     String        @map("supplier_id") @db.Uuid
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseId     String?       @map("purchase_id") @db.Uuid
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  paymentGroupId String?       @map("payment_group_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paymentDate    DateTime      @map("payment_date") @db.Timestamptz(3)
  method         PaymentMethod
  notes          String?
  receiptNumber  String?       @map("receipt_number")
  createdAt      DateTime      @default(now()) @map("created_at")
  reversals      SupplierPaymentReversal[]
  refundSettlementLines SupplierRefundSettlementLine[]
  supplierCredits SupplierCredit[]
  transferDecisions SupplierPaymentTransferDecision[]

  @@index([supplierId, paymentDate])
  @@index([purchaseId])
  @@index([paymentGroupId])
  @@map("supplier_payments")
}

model SupplierCredit {
  id                String @id @default(uuid()) @db.Uuid
  supplierId        String @map("supplier_id") @db.Uuid
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  cancellationId    String @map("cancellation_id") @db.Uuid
  cancellation      PurchaseCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  sourcePaymentId   String @map("source_payment_id") @db.Uuid
  sourcePayment     SupplierPayment @relation(fields: [sourcePaymentId], references: [id], onDelete: Restrict)
  amount            Decimal @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  applications      SupplierCreditApplication[]
  reversals         SupplierCreditReversal[]

  @@unique([cancellationId, sourcePaymentId])
  @@index([supplierId, createdAt])
  @@map("supplier_credits")
}

model SupplierCreditApplication {
  id          String @id @default(uuid()) @db.Uuid
  creditId    String @map("credit_id") @db.Uuid
  credit      SupplierCredit @relation(fields: [creditId], references: [id], onDelete: Restrict)
  purchaseId  String @map("purchase_id") @db.Uuid
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  amount      Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reversals   SupplierCreditApplicationReversal[]

  @@index([creditId, createdAt])
  @@index([purchaseId])
  @@map("supplier_credit_applications")
}

model SupplierCreditApplicationReversal {
  id              String @id @default(uuid()) @db.Uuid
  cancellationId  String @map("cancellation_id") @db.Uuid
  cancellation    PurchaseCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  applicationId   String @map("application_id") @db.Uuid
  application     SupplierCreditApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  amount          Decimal @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cancellationId, applicationId])
  @@index([applicationId])
  @@map("supplier_credit_application_reversals")
}

model SupplierCreditReversal {
  id             String               @id @default(uuid()) @db.Uuid
  cancellationId String               @map("cancellation_id") @db.Uuid
  cancellation   PurchaseCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  creditId       String               @map("credit_id") @db.Uuid
  credit         SupplierCredit       @relation(fields: [creditId], references: [id], onDelete: Restrict)
  amount         Decimal              @db.Decimal(12, 2)
  reason         String
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cancellationId, creditId])
  @@index([creditId, createdAt])
  @@map("supplier_credit_reversals")
}

model PurchaseCancellation {
  id              String   @id @default(uuid()) @db.Uuid
  idempotencyKey  String   @unique @map("idempotency_key") @db.Uuid
  purchaseId      String   @unique @map("purchase_id") @db.Uuid
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  reason          String
  cancelledAt     DateTime @default(now()) @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?  @map("cancelled_by_id") @db.Uuid
  cancelledBy     User?    @relation(fields: [cancelledById], references: [id], onDelete: Restrict)
  paymentReversals SupplierPaymentReversal[]
  paymentTransferDecisions SupplierPaymentTransferDecision[]
  supplierRefund   SupplierRefund?
  supplierCredits SupplierCredit[]
  supplierCreditApplicationReversals SupplierCreditApplicationReversal[]
  supplierCreditReversals SupplierCreditReversal[]

  @@index([cancelledAt])
  @@index([cancelledById])
  @@map("purchase_cancellations")
}

model SupplierPaymentReversal {
  id                String               @id @default(uuid()) @db.Uuid
  cancellationId    String               @map("cancellation_id") @db.Uuid
  cancellation      PurchaseCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  originalPaymentId String               @map("original_payment_id") @db.Uuid
  originalPayment   SupplierPayment      @relation(fields: [originalPaymentId], references: [id], onDelete: Restrict)
  amount            Decimal              @db.Decimal(12, 2)
  reason            String
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cancellationId, originalPaymentId])
  @@index([originalPaymentId])
  @@map("supplier_payment_reversals")
}

model SupplierPaymentTransferDecision {
  id                String               @id @default(uuid()) @db.Uuid
  cancellationId    String               @map("cancellation_id") @db.Uuid
  cancellation      PurchaseCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  originalPaymentId String               @map("original_payment_id") @db.Uuid
  originalPayment   SupplierPayment      @relation(fields: [originalPaymentId], references: [id], onDelete: Restrict)
  paymentGroupId    String?              @map("payment_group_id") @db.Uuid
  wasTransferred    Boolean              @map("was_transferred")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([cancellationId, originalPaymentId])
  @@index([paymentGroupId, createdAt])
  @@map("supplier_payment_transfer_decisions")
}

model SupplierRefund {
  id             String               @id @default(uuid()) @db.Uuid
  cancellationId String               @unique @map("cancellation_id") @db.Uuid
  cancellation   PurchaseCancellation @relation(fields: [cancellationId], references: [id], onDelete: Restrict)
  amount         Decimal              @db.Decimal(12, 2)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  settlements    SupplierRefundSettlement[]

  @@map("supplier_refunds")
}

model SupplierRefundSettlement {
  id             String                         @id @default(uuid()) @db.Uuid
  idempotencyKey String                         @unique @map("idempotency_key") @db.Uuid
  refundId       String                         @map("refund_id") @db.Uuid
  refund         SupplierRefund                 @relation(fields: [refundId], references: [id], onDelete: Restrict)
  createdById    String?                        @map("created_by_id") @db.Uuid
  createdBy      User?                          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  settledAt      DateTime                       @default(now()) @map("settled_at") @db.Timestamptz(3)
  lines          SupplierRefundSettlementLine[]

  @@index([refundId, settledAt])
  @@index([createdById])
  @@map("supplier_refund_settlements")
}

model SupplierRefundSettlementLine {
  id           String                   @id @default(uuid()) @db.Uuid
  settlementId String                   @map("settlement_id") @db.Uuid
  settlement   SupplierRefundSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  originalPaymentId String               @map("original_payment_id") @db.Uuid
  originalPayment   SupplierPayment      @relation(fields: [originalPaymentId], references: [id], onDelete: Restrict)
  amount       Decimal                  @db.Decimal(12, 2)
  method       RefundMethod
  reference    String?

  @@index([settlementId])
  @@index([originalPaymentId])
  @@map("supplier_refund_settlement_lines")
}

model Expense {
  id            String         @id @default(uuid()) @db.Uuid
  description   String
  category      String
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime       @map("expense_date") @db.Timestamptz(3)
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([expenseDate, category])
  @@map("expenses")
}
